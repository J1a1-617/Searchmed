# Copy these exports into your shell or secret manager. Never commit a real API key.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://yeysai.com/v1
MODEL_NAME=gpt-5
LLM_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRIES=1

# Backward-compatible aliases also supported by LLMClient:
# DEFAULT_OPENAI_API_KEY=replace-with-your-key
# DEFAULT_BASE_URL=https://yeysai.com/v1
